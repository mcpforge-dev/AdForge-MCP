generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider     = "postgresql"
  relationMode = "foreignKeys"
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum AuditActorType {
  HUMAN
  SERVICE
}

enum ProviderId {
  GOOGLE_ADS
  META_ADS
  YANDEX_DIRECT
  TIKTOK_ADS
  TEST_PROVIDER
}

enum ProviderConnectionStatus {
  PENDING
  CONNECTED
  DEGRADED
  REAUTH_REQUIRED
  REVOKED
  DISCONNECTED
  ERROR
}

model User {
  id                String               @id @default(uuid()) @db.Uuid
  email             String               @unique @db.VarChar(320)
  name              String               @db.VarChar(160)
  passwordHash      String               @map("password_hash") @db.VarChar(255)
  emailVerifiedAt   DateTime?            @map("email_verified_at")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  memberships       WorkspaceMembership[]
  sessions          Session[]
  emailVerifications EmailVerification[]
  passwordResets    PasswordReset[]
  invitationsSent   WorkspaceInvitation[] @relation("inviter")
  auditEvents       AuditEvent[]
  connections       ProviderConnection[]
  oauthStates       OAuthState[]

  @@index([email])
  @@map("users")
}

model Workspace {
  id           String               @id @default(uuid()) @db.Uuid
  name         String               @db.VarChar(160)
  slug         String               @unique @db.VarChar(120)
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  memberships  WorkspaceMembership[]
  invitations  WorkspaceInvitation[]
  auditEvents  AuditEvent[]
  identities   ServiceIdentity[]
  connections  ProviderConnection[]
  providerAccounts ProviderAccount[]
  oauthStates  OAuthState[]

  @@index([createdAt])
  @@map("workspaces")
}

model WorkspaceMembership {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId, workspaceId])
  @@index([workspaceId, role])
  @@map("workspace_memberships")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique @db.VarChar(120)
  description String           @db.VarChar(255)
  roleLinks   RolePermission[]

  @@map("permissions")
}

model RolePermission {
  role         WorkspaceRole @map("role")
  permissionId String        @map("permission_id") @db.Uuid
  permission   Permission    @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([role, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Session {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenDigest  String    @unique @map("token_digest") @db.VarChar(128)
  createdAt    DateTime  @default(now()) @map("created_at")
  expiresAt    DateTime  @map("expires_at")
  lastSeenAt   DateTime  @default(now()) @map("last_seen_at")
  revokedAt    DateTime? @map("revoked_at")
  userAgent    String?   @map("user_agent") @db.VarChar(512)
  ipHash       String?   @map("ip_hash") @db.VarChar(128)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

model EmailVerification {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenDigest String    @unique @map("token_digest") @db.VarChar(128)
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([expiresAt])
  @@map("email_verifications")
}

model PasswordReset {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenDigest String    @unique @map("token_digest") @db.VarChar(128)
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([expiresAt])
  @@map("password_resets")
}

model WorkspaceInvitation {
  id         String        @id @default(uuid()) @db.Uuid
  workspaceId String       @map("workspace_id") @db.Uuid
  inviterId  String        @map("inviter_id") @db.Uuid
  email      String        @db.VarChar(320)
  role       WorkspaceRole @default(MEMBER)
  tokenDigest String       @unique @map("token_digest") @db.VarChar(128)
  expiresAt  DateTime      @map("expires_at")
  acceptedAt DateTime?     @map("accepted_at")
  revokedAt  DateTime?     @map("revoked_at")
  createdAt  DateTime      @default(now()) @map("created_at")
  workspace  Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inviter    User          @relation("inviter", fields: [inviterId], references: [id], onDelete: Restrict)

  @@index([workspaceId, email])
  @@index([workspaceId, expiresAt])
  @@map("workspace_invitations")
}

model ServiceIdentity {
  id          String     @id @default(uuid()) @db.Uuid
  workspaceId String?    @map("workspace_id") @db.Uuid
  name        String     @db.VarChar(160)
  createdAt   DateTime   @default(now()) @map("created_at")
  revokedAt   DateTime?  @map("revoked_at")
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, revokedAt])
  @@map("service_identities")
}

model AuditEvent {
  id           String         @id @default(uuid()) @db.Uuid
  workspaceId  String?        @map("workspace_id") @db.Uuid
  actorUserId  String?        @map("actor_user_id") @db.Uuid
  actorType    AuditActorType @default(HUMAN) @map("actor_type")
  eventType    String         @map("event_type") @db.VarChar(120)
  success      Boolean        @default(true)
  targetType   String?        @map("target_type") @db.VarChar(120)
  targetId     String?        @map("target_id") @db.VarChar(160)
  requestId    String?        @map("request_id") @db.VarChar(128)
  metadata     Json?
  createdAt    DateTime       @default(now()) @map("created_at")
  workspace    Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  actorUser    User?          @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([eventType, createdAt])
  @@map("audit_events")
}

model SystemMetadata {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique @db.VarChar(160)
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([updatedAt])
  @@map("system_metadata")
}

model ProviderConnection {
  id                String                   @id @default(uuid()) @db.Uuid
  workspaceId       String                   @map("workspace_id") @db.Uuid
  provider          ProviderId
  status            ProviderConnectionStatus @default(PENDING)
  externalSubjectId String?                  @map("external_subject_id") @db.VarChar(255)
  displayName       String?                  @map("display_name") @db.VarChar(255)
  createdBy         String                   @map("created_by") @db.Uuid
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")
  connectedAt       DateTime?                @map("connected_at")
  disconnectedAt    DateTime?                @map("disconnected_at")
  lastSuccessAt     DateTime?                @map("last_success_at")
  lastErrorAt       DateTime?                @map("last_error_at")
  lastErrorCode     String?                  @map("last_error_code") @db.VarChar(120)
  credentialVersion Int                      @default(0) @map("credential_version")
  metadata          Json?
  workspace         Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator           User                     @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  credential        ProviderCredential?
  accounts          ProviderAccount[]
  oauthStates       OAuthState[]

  @@unique([workspaceId, provider])
  @@unique([id, workspaceId, provider])
  @@index([workspaceId, status])
  @@index([createdBy])
  @@map("provider_connections")
}

model ProviderCredential {
  id                   String             @id @default(uuid()) @db.Uuid
  connectionId         String             @unique @map("connection_id") @db.Uuid
  encryptedPayload     String             @map("encrypted_payload") @db.Text
  encryptionVersion    Int                @map("encryption_version")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  connection           ProviderConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([encryptionVersion])
  @@map("provider_credentials")
}

model ProviderAccount {
  id                String             @id @default(uuid()) @db.Uuid
  connectionId      String             @map("connection_id") @db.Uuid
  workspaceId       String             @map("workspace_id") @db.Uuid
  provider          ProviderId
  externalAccountId String             @map("external_account_id") @db.VarChar(255)
  displayName       String             @map("display_name") @db.VarChar(255)
  currency          String?            @db.VarChar(16)
  timezone          String?            @db.VarChar(80)
  status            String?            @db.VarChar(80)
  enabled           Boolean            @default(false)
  metadata          Json?
  discoveredAt      DateTime           @default(now()) @map("discovered_at")
  lastSeenAt        DateTime           @default(now()) @map("last_seen_at")
  connection        ProviderConnection @relation(fields: [connectionId, workspaceId, provider], references: [id, workspaceId, provider], onDelete: Cascade)
  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider, externalAccountId])
  @@index([connectionId, enabled])
  @@index([workspaceId, provider, status])
  @@map("provider_accounts")
}

model OAuthState {
  id                    String             @id @default(uuid()) @db.Uuid
  stateDigest           String             @unique @map("state_digest") @db.VarChar(128)
  userId                String             @map("user_id") @db.Uuid
  workspaceId           String             @map("workspace_id") @db.Uuid
  provider              ProviderId
  sessionId             String             @map("session_id") @db.Uuid
  codeVerifierCiphertext String?           @map("code_verifier_ciphertext") @db.Text
  codeVerifierEncryptionVersion Int?       @map("code_verifier_encryption_version")
  codeChallenge         String?            @map("code_challenge") @db.VarChar(128)
  expiresAt              DateTime           @map("expires_at")
  consumedAt            DateTime?          @map("consumed_at")
  createdAt              DateTime           @default(now()) @map("created_at")
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace             Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection            ProviderConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  connectionId          String?            @map("connection_id") @db.Uuid

  @@index([workspaceId, provider, expiresAt])
  @@index([userId, sessionId, expiresAt])
  @@map("oauth_states")
}
