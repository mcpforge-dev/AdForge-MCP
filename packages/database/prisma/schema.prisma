generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider     = "postgresql"
  relationMode = "foreignKeys"
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum AuditActorType {
  HUMAN
  SERVICE
}

enum ProviderId {
  GOOGLE_ADS
  META_ADS
  YANDEX_DIRECT
  TIKTOK_ADS
  TEST_PROVIDER
}

enum ProviderConnectionStatus {
  PENDING
  CONNECTED
  DEGRADED
  REAUTH_REQUIRED
  REVOKED
  DISCONNECTED
  ERROR
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum BillingOrderStatus {
  OPEN
  PAID
  FAILED
  CANCELED
}

enum PaymentAttemptStatus {
  CREATED
  PENDING
  SUCCEEDED
  FAILED
}

enum ManualConnectionRequestStatus {
  NEW
  IN_PROGRESS
  WAITING_FOR_CLIENT
  READY_FOR_CONNECTION
  COMPLETED
  CANCELED
}

model User {
  id                String               @id @default(uuid()) @db.Uuid
  email             String               @unique @db.VarChar(320)
  name              String               @db.VarChar(160)
  passwordHash      String               @map("password_hash") @db.VarChar(255)
  emailVerifiedAt   DateTime?            @map("email_verified_at")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  memberships       WorkspaceMembership[]
  sessions          Session[]
  emailVerifications EmailVerification[]
  passwordResets    PasswordReset[]
  invitationsSent   WorkspaceInvitation[] @relation("inviter")
  auditEvents       AuditEvent[]
  connections       ProviderConnection[]
  oauthStates       OAuthState[]
  manualConnectionRequests ManualConnectionRequest[]

  @@index([email])
  @@map("users")
}

model Workspace {
  id           String               @id @default(uuid()) @db.Uuid
  name         String               @db.VarChar(160)
  slug         String               @unique @db.VarChar(120)
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  memberships  WorkspaceMembership[]
  invitations  WorkspaceInvitation[]
  auditEvents  AuditEvent[]
  identities   ServiceIdentity[]
  connections  ProviderConnection[]
  providerAccounts ProviderAccount[]
  oauthStates  OAuthState[]
  subscriptions WorkspaceSubscription[]
  billingOrders BillingOrder[]
  usageRecords UsageRecord[]
  entitlements Entitlement[]
  manualConnectionRequests ManualConnectionRequest[]

  @@index([createdAt])
  @@map("workspaces")
}

model WorkspaceMembership {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId, workspaceId])
  @@index([workspaceId, role])
  @@map("workspace_memberships")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique @db.VarChar(120)
  description String           @db.VarChar(255)
  roleLinks   RolePermission[]

  @@map("permissions")
}

model RolePermission {
  role         WorkspaceRole @map("role")
  permissionId String        @map("permission_id") @db.Uuid
  permission   Permission    @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([role, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Session {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenDigest  String    @unique @map("token_digest") @db.VarChar(128)
  createdAt    DateTime  @default(now()) @map("created_at")
  expiresAt    DateTime  @map("expires_at")
  lastSeenAt   DateTime  @default(now()) @map("last_seen_at")
  revokedAt    DateTime? @map("revoked_at")
  userAgent    String?   @map("user_agent") @db.VarChar(512)
  ipHash       String?   @map("ip_hash") @db.VarChar(128)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

model EmailVerification {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenDigest String    @unique @map("token_digest") @db.VarChar(128)
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([expiresAt])
  @@map("email_verifications")
}

model PasswordReset {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenDigest String    @unique @map("token_digest") @db.VarChar(128)
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([expiresAt])
  @@map("password_resets")
}

model WorkspaceInvitation {
  id         String        @id @default(uuid()) @db.Uuid
  workspaceId String       @map("workspace_id") @db.Uuid
  inviterId  String        @map("inviter_id") @db.Uuid
  email      String        @db.VarChar(320)
  role       WorkspaceRole @default(MEMBER)
  tokenDigest String       @unique @map("token_digest") @db.VarChar(128)
  expiresAt  DateTime      @map("expires_at")
  acceptedAt DateTime?     @map("accepted_at")
  revokedAt  DateTime?     @map("revoked_at")
  createdAt  DateTime      @default(now()) @map("created_at")
  workspace  Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inviter    User          @relation("inviter", fields: [inviterId], references: [id], onDelete: Restrict)

  @@index([workspaceId, email])
  @@index([workspaceId, expiresAt])
  @@map("workspace_invitations")
}

model ServiceIdentity {
  id          String     @id @default(uuid()) @db.Uuid
  workspaceId String?    @map("workspace_id") @db.Uuid
  name        String     @db.VarChar(160)
  createdAt   DateTime   @default(now()) @map("created_at")
  revokedAt   DateTime?  @map("revoked_at")
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tokens      ServiceToken[]

  @@index([workspaceId, revokedAt])
  @@map("service_identities")
}

model ServiceToken {
  id                String          @id @default(uuid()) @db.Uuid
  serviceIdentityId String          @map("service_identity_id") @db.Uuid
  tokenDigest       String          @unique @map("token_digest") @db.VarChar(128)
  tokenPrefix       String          @map("token_prefix") @db.VarChar(32)
  name              String          @db.VarChar(160)
  scopes            Json
  accountIds        Json?           @map("account_ids")
  createdAt         DateTime        @default(now()) @map("created_at")
  expiresAt         DateTime?       @map("expires_at")
  revokedAt         DateTime?       @map("revoked_at")
  lastUsedAt        DateTime?       @map("last_used_at")
  serviceIdentity   ServiceIdentity @relation(fields: [serviceIdentityId], references: [id], onDelete: Cascade)

  @@index([serviceIdentityId, revokedAt])
  @@index([expiresAt])
  @@map("service_tokens")
}

model AuditEvent {
  id           String         @id @default(uuid()) @db.Uuid
  workspaceId  String?        @map("workspace_id") @db.Uuid
  actorUserId  String?        @map("actor_user_id") @db.Uuid
  actorType    AuditActorType @default(HUMAN) @map("actor_type")
  eventType    String         @map("event_type") @db.VarChar(120)
  success      Boolean        @default(true)
  targetType   String?        @map("target_type") @db.VarChar(120)
  targetId     String?        @map("target_id") @db.VarChar(160)
  requestId    String?        @map("request_id") @db.VarChar(128)
  metadata     Json?
  createdAt    DateTime       @default(now()) @map("created_at")
  workspace    Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  actorUser    User?          @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([eventType, createdAt])
  @@map("audit_events")
}

model SystemMetadata {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique @db.VarChar(160)
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([updatedAt])
  @@map("system_metadata")
}

model ManualConnectionRequest {
  id                String                         @id @default(uuid()) @db.Uuid
  workspaceId       String                         @map("workspace_id") @db.Uuid
  userId            String                         @map("user_id") @db.Uuid
  provider          ProviderId                     @default(META_ADS)
  companyName       String                         @map("company_name") @db.VarChar(160)
  metaBusinessId    String?                        @map("meta_business_id") @db.VarChar(64)
  metaAdAccountId   String                         @map("meta_ad_account_id") @db.VarChar(64)
  metaPageId        String?                        @map("meta_page_id") @db.VarChar(64)
  instagramUsername String?                        @map("instagram_username") @db.VarChar(80)
  contactPreference String                         @default("email") @map("contact_preference") @db.VarChar(24)
  clientNote        String                         @default("") @map("client_note") @db.VarChar(2000)
  status            ManualConnectionRequestStatus @default(NEW)
  specialistNote    String                         @default("") @map("specialist_note") @db.VarChar(2000)
  assignedTo        String?                        @map("assigned_to") @db.Uuid
  createdAt         DateTime                       @default(now()) @map("created_at")
  updatedAt         DateTime                       @updatedAt @map("updated_at")
  workspace         Workspace                      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user              User                           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, createdAt])
  @@index([userId, provider, status])
  @@map("manual_connection_requests")
}

model Plan {
  id            String                  @id @default(uuid()) @db.Uuid
  key           String                  @unique @db.VarChar(80)
  name          String                  @db.VarChar(160)
  description   String?                 @db.VarChar(500)
  active        Boolean                 @default(true)
  features      Json
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")
  prices        Price[]
  subscriptions WorkspaceSubscription[]
  orders        BillingOrder[]
  @@index([active])
  @@map("plans")
}

model Price {
  id             String                  @id @default(uuid()) @db.Uuid
  planId         String                  @map("plan_id") @db.Uuid
  currency       String                  @db.VarChar(3)
  amount         Decimal                 @db.Decimal(18, 6)
  interval       String                  @db.VarChar(32)
  active         Boolean                 @default(true)
  provider       String?                 @db.VarChar(80)
  providerPriceRef String?               @map("provider_price_ref") @db.VarChar(255)
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")
  plan           Plan                    @relation(fields: [planId], references: [id], onDelete: Restrict)
  subscriptions  WorkspaceSubscription[]
  orders         BillingOrder[]
  @@unique([planId, currency, interval])
  @@index([active, currency])
  @@map("prices")
}

model WorkspaceSubscription {
  id                       String             @id @default(uuid()) @db.Uuid
  workspaceId              String             @map("workspace_id") @db.Uuid
  planId                   String             @map("plan_id") @db.Uuid
  priceId                  String?            @map("price_id") @db.Uuid
  status                   SubscriptionStatus @default(TRIALING)
  startsAt                 DateTime           @map("starts_at")
  currentPeriodStart      DateTime           @map("current_period_start")
  currentPeriodEnd        DateTime           @map("current_period_end")
  trialEndsAt              DateTime?          @map("trial_ends_at")
  canceledAt               DateTime?          @map("canceled_at")
  providerCustomerRef      String?            @map("provider_customer_ref") @db.VarChar(255)
  providerSubscriptionRef  String?            @map("provider_subscription_ref") @db.VarChar(255)
  metadata                 Json?
  createdAt                DateTime           @default(now()) @map("created_at")
  updatedAt                DateTime           @updatedAt @map("updated_at")
  workspace                Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan                     Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  price                    Price?             @relation(fields: [priceId], references: [id], onDelete: SetNull)
  @@index([workspaceId, status])
  @@index([currentPeriodEnd])
  @@map("workspace_subscriptions")
}

model BillingOrder {
  id                     String             @id @default(uuid()) @db.Uuid
  workspaceId            String             @map("workspace_id") @db.Uuid
  planId                 String             @map("plan_id") @db.Uuid
  priceId                String?            @map("price_id") @db.Uuid
  status                 BillingOrderStatus @default(OPEN)
  currency               String             @db.VarChar(3)
  amount                 Decimal            @db.Decimal(18, 6)
  idempotencyKey         String             @unique @map("idempotency_key") @db.VarChar(160)
  providerOrderRef       String?            @map("provider_order_ref") @db.VarChar(255)
  createdAt               DateTime           @default(now()) @map("created_at")
  updatedAt               DateTime           @updatedAt @map("updated_at")
  paidAt                  DateTime?          @map("paid_at")
  workspace               Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan                   Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  price                  Price?             @relation(fields: [priceId], references: [id], onDelete: SetNull)
  attempts               PaymentAttempt[]
  @@index([workspaceId, createdAt])
  @@index([status, createdAt])
  @@map("billing_orders")
}

model PaymentAttempt {
  id                 String                @id @default(uuid()) @db.Uuid
  orderId            String                @map("order_id") @db.Uuid
  provider           String                @db.VarChar(80)
  status             PaymentAttemptStatus  @default(CREATED)
  providerPaymentRef String?               @map("provider_payment_ref") @db.VarChar(255)
  idempotencyKey     String                @unique @map("idempotency_key") @db.VarChar(160)
  errorCode          String?               @map("error_code") @db.VarChar(120)
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")
  order              BillingOrder          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@index([orderId, status])
  @@map("payment_attempts")
}

model UsageRecord {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  metricKey   String   @map("metric_key") @db.VarChar(120)
  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")
  quantity    Decimal  @db.Decimal(24, 6)
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@unique([workspaceId, metricKey, periodStart, periodEnd])
  @@index([workspaceId, periodEnd])
  @@map("usage_records")
}

model Entitlement {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  featureKey  String   @map("feature_key") @db.VarChar(120)
  value       Json
  source      String   @db.VarChar(80)
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@unique([workspaceId, featureKey])
  @@index([workspaceId, expiresAt])
  @@map("entitlements")
}

model ProviderConnection {
  id                String                   @id @default(uuid()) @db.Uuid
  workspaceId       String                   @map("workspace_id") @db.Uuid
  provider          ProviderId
  status            ProviderConnectionStatus @default(PENDING)
  externalSubjectId String?                  @map("external_subject_id") @db.VarChar(255)
  displayName       String?                  @map("display_name") @db.VarChar(255)
  createdBy         String                   @map("created_by") @db.Uuid
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")
  connectedAt       DateTime?                @map("connected_at")
  disconnectedAt    DateTime?                @map("disconnected_at")
  lastSuccessAt     DateTime?                @map("last_success_at")
  lastErrorAt       DateTime?                @map("last_error_at")
  lastErrorCode     String?                  @map("last_error_code") @db.VarChar(120)
  credentialVersion Int                      @default(0) @map("credential_version")
  metadata          Json?
  workspace         Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator           User                     @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  credential        ProviderCredential?
  accounts          ProviderAccount[]
  oauthStates       OAuthState[]

  @@unique([workspaceId, provider])
  @@unique([id, workspaceId, provider])
  @@index([workspaceId, status])
  @@index([createdBy])
  @@map("provider_connections")
}

model ProviderCredential {
  id                   String             @id @default(uuid()) @db.Uuid
  connectionId         String             @unique @map("connection_id") @db.Uuid
  encryptedPayload     String             @map("encrypted_payload") @db.Text
  encryptionVersion    Int                @map("encryption_version")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  connection           ProviderConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([encryptionVersion])
  @@map("provider_credentials")
}

model ProviderAccount {
  id                String             @id @default(uuid()) @db.Uuid
  connectionId      String             @map("connection_id") @db.Uuid
  workspaceId       String             @map("workspace_id") @db.Uuid
  provider          ProviderId
  externalAccountId String             @map("external_account_id") @db.VarChar(255)
  displayName       String             @map("display_name") @db.VarChar(255)
  currency          String?            @db.VarChar(16)
  timezone          String?            @db.VarChar(80)
  status            String?            @db.VarChar(80)
  enabled           Boolean            @default(false)
  metadata          Json?
  discoveredAt      DateTime           @default(now()) @map("discovered_at")
  lastSeenAt        DateTime           @default(now()) @map("last_seen_at")
  connection        ProviderConnection @relation(fields: [connectionId, workspaceId, provider], references: [id, workspaceId, provider], onDelete: Cascade)
  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider, externalAccountId])
  @@index([connectionId, enabled])
  @@index([workspaceId, provider, status])
  @@map("provider_accounts")
}

model OAuthState {
  id                    String             @id @default(uuid()) @db.Uuid
  stateDigest           String             @unique @map("state_digest") @db.VarChar(128)
  userId                String             @map("user_id") @db.Uuid
  workspaceId           String             @map("workspace_id") @db.Uuid
  provider              ProviderId
  sessionId             String             @map("session_id") @db.Uuid
  codeVerifierCiphertext String?           @map("code_verifier_ciphertext") @db.Text
  codeVerifierEncryptionVersion Int?       @map("code_verifier_encryption_version")
  codeChallenge         String?            @map("code_challenge") @db.VarChar(128)
  expiresAt              DateTime           @map("expires_at")
  consumedAt            DateTime?          @map("consumed_at")
  createdAt              DateTime           @default(now()) @map("created_at")
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace             Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection            ProviderConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  connectionId          String?            @map("connection_id") @db.Uuid

  @@index([workspaceId, provider, expiresAt])
  @@index([userId, sessionId, expiresAt])
  @@map("oauth_states")
}
