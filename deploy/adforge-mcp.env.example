# HolyMedia MCP hosted beta environment template.
# Copy to /etc/adforge-mcp/adforge-mcp.env on the VPS and fill placeholders there.
# Do not commit real values.

AD_MCP_ENV=beta
AD_MCP_LOG_LEVEL=INFO

# Internal bind addresses behind Nginx.
AD_MCP_WEB_HOST=127.0.0.1
AD_MCP_WEB_PORT=8765
AD_MCP_MCP_HTTP_HOST=127.0.0.1
AD_MCP_MCP_HTTP_PORT=8766
AD_MCP_MCP_ENDPOINT_PATH=/mcp

# Public URLs.
AD_MCP_PUBLIC_BASE_URL=https://your-domain.com
AD_MCP_MCP_PUBLIC_URL=https://your-domain.com/mcp

# Beta access gate. Generate on the server, for example:
# openssl rand -hex 32
AD_MCP_WEB_API_TOKEN=
# Fernet key generated outside Git and injected by systemd/secret manager.
AD_MCP_CREDENTIALS_ENCRYPTION_KEY=
# Temporary migration switch; set false after the encrypted-store migration.
AD_MCP_CREDENTIALS_ALLOW_LEGACY_PLAINTEXT=false
# Legacy beta token is denied unless explicitly mapped to one workspace/accounts.
AD_MCP_LEGACY_MCP_TOKEN_ENABLED=false
AD_MCP_LEGACY_MCP_WORKSPACE_ID=
AD_MCP_LEGACY_MCP_ALLOWED_ACCOUNTS_JSON={}

# SaaS auth foundation. Use PostgreSQL for live beta; SQLite is only a local fallback.
# Example:
# AD_MCP_DATABASE_URL=postgresql://adforge_user:change-me@127.0.0.1:5432/adforge_mcp
AD_MCP_DATABASE_URL=
AD_MCP_AUTH_ENABLED=true
AD_MCP_AUTH_SESSION_COOKIE_NAME=adforge_session
AD_MCP_AUTH_SESSION_TTL_HOURS=720
AD_MCP_AUTH_SECURE_COOKIES=true
AD_MCP_AUTH_ALLOW_PUBLIC_REGISTRATION=true
AD_MCP_AUTH_REGISTRATION_CODE=
AD_MCP_INITIAL_ADMIN_EMAIL=listok.2004@list.ru

# Account profile, avatar upload and email password reset.
AD_MCP_SMTP_HOST=
AD_MCP_SMTP_PORT=587
AD_MCP_SMTP_USERNAME=
AD_MCP_SMTP_PASSWORD=
AD_MCP_SMTP_FROM_EMAIL=
AD_MCP_SMTP_FROM_NAME="HolyMedia MCP"
AD_MCP_SMTP_USE_TLS=true
AD_MCP_SMTP_USE_SSL=false
AD_MCP_PASSWORD_RESET_TTL_MINUTES=30
AD_MCP_PROFILE_UPLOAD_DIR=/var/lib/adforge-mcp/uploads
AD_MCP_PROFILE_MAX_AVATAR_BYTES=2097152

# Beta safety mode. Keep true until real write actions are approved.
AD_MCP_PREVIEW_ONLY=true

# Hosted OAuth connection storage.
AD_MCP_CONNECTION_STORE_PATH=/var/lib/adforge-mcp/connections.json
AD_MCP_CONNECTIONS_FALLBACK_TO_LOCAL=false
AD_MCP_AUDIT_LOG_PATH=/var/log/adforge-mcp/audit.jsonl

# Meta Ads OAuth.
AD_MCP_META_OAUTH_APP_ID=your-meta-app-id
AD_MCP_META_OAUTH_APP_SECRET=your-meta-app-secret
AD_MCP_META_OAUTH_API_VERSION=v20.0
AD_MCP_META_OAUTH_SCOPES=ads_read,business_management,pages_show_list,pages_read_engagement
# Пока Meta App Review не завершён, показываем клиенту ручную заявку вместо публичного OAuth.
AD_MCP_META_MANUAL_ONBOARDING_ENABLED=true
AD_MCP_META_ADS_MANAGEMENT_OAUTH_ENABLED=false
AD_MCP_META_APP_REVIEW_COMMIT_ENABLED=false
AD_MCP_META_APP_REVIEW_ALLOWED_ACCOUNT_ID=
AD_MCP_META_APP_REVIEW_ALLOWED_OBJECT_IDS=
AD_MCP_META_APP_REVIEW_ALLOWED_ACTIONS=change_name
AD_MCP_META_CONFIRMED_WRITE_ENABLED=false
AD_MCP_META_CONFIRMED_WRITE_ALLOWED_ACCOUNT_IDS=
AD_MCP_META_CONFIRMED_WRITE_ALLOWED_OBJECT_IDS=
AD_MCP_META_CONFIRMED_WRITE_ALLOWED_ACTIONS=create_campaign,create_adset,create_creative,create_ad,change_name,pause_campaign,resume_campaign,update_campaign,update_adset,update_ad
AD_MCP_META_CONFIRMED_WRITE_REQUIRE_PAUSED_OBJECTS=true
AD_MCP_META_OAUTH_REDIRECT_PATH=/oauth/meta/callback

# Google Ads OAuth.
AD_MCP_GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
AD_MCP_GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
AD_MCP_GOOGLE_ADS_DEVELOPER_TOKEN=your-google-ads-developer-token
AD_MCP_GOOGLE_ADS_LOGIN_CUSTOMER_ID=
AD_MCP_GOOGLE_ADS_API_VERSION=v20
AD_MCP_GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/adwords
AD_MCP_GOOGLE_OAUTH_REDIRECT_PATH=/oauth/google/callback

# Google Search Console OAuth for SEO reports. Uses the Google OAuth client,
# but stores selected Search Console properties separately from Google Ads accounts.
AD_MCP_GOOGLE_SEARCH_CONSOLE_SCOPES=https://www.googleapis.com/auth/webmasters.readonly
AD_MCP_GOOGLE_SEARCH_CONSOLE_REDIRECT_PATH=/oauth/google-search-console/callback

# TikTok Ads OAuth.
AD_MCP_TIKTOK_OAUTH_APP_ID=your-tiktok-app-id
AD_MCP_TIKTOK_OAUTH_APP_SECRET=your-tiktok-app-secret
AD_MCP_TIKTOK_OAUTH_SCOPES=
AD_MCP_TIKTOK_OAUTH_ADVERTISER_ID=
AD_MCP_TIKTOK_OAUTH_AUTH_URL=https://ads.tiktok.com/marketing_api/auth
AD_MCP_TIKTOK_OAUTH_TOKEN_URL=https://business-api.tiktok.com/open_api/v1.3/oauth2/access_token/
AD_MCP_TIKTOK_OAUTH_ADVERTISER_GET_URL=https://business-api.tiktok.com/open_api/v1.3/oauth2/advertiser/get/
AD_MCP_TIKTOK_OAUTH_REDIRECT_PATH=/oauth/tiktok/callback

# Yandex Direct OAuth.
AD_MCP_YANDEX_OAUTH_CLIENT_ID=your-yandex-oauth-client-id
AD_MCP_YANDEX_OAUTH_CLIENT_SECRET=your-yandex-oauth-client-secret
AD_MCP_YANDEX_OAUTH_SCOPE=direct:api
AD_MCP_YANDEX_OAUTH_AUTHORIZE_URL=https://oauth.yandex.ru/authorize
AD_MCP_YANDEX_OAUTH_TOKEN_URL=https://oauth.yandex.ru/token
AD_MCP_YANDEX_DIRECT_CLIENTS_URL=https://api.direct.yandex.com/json/v5/clients
AD_MCP_YANDEX_DIRECT_LOGIN=
AD_MCP_YANDEX_DIRECT_CLIENT_LOGIN=
AD_MCP_YANDEX_OAUTH_REDIRECT_PATH=/oauth/yandex/callback

# Optional ClickHouse persistence, disabled for hosted beta by default.
AD_MCP_CLICKHOUSE_ENABLED=false
AD_MCP_CLICKHOUSE_HOST=127.0.0.1
AD_MCP_CLICKHOUSE_PORT=8123
AD_MCP_CLICKHOUSE_DATABASE=ad_mcp_ai
AD_MCP_CLICKHOUSE_USER=default
AD_MCP_CLICKHOUSE_PASSWORD=
AD_MCP_CLICKHOUSE_SECURE=false
