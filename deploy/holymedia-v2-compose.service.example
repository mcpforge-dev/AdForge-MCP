[Unit]
Description=HolyMedia MCP v2 production Compose stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/adforge-mcp-v2
ExecStart=/usr/bin/docker compose --env-file /etc/holymedia-v2/compose.env -f /opt/adforge-mcp-v2/infra/docker-compose.v2.production.yml up -d
ExecStop=/usr/bin/docker compose --env-file /etc/holymedia-v2/compose.env -f /opt/adforge-mcp-v2/infra/docker-compose.v2.production.yml down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
