{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Client answer",
  "type": "object",
  "required": ["question_id", "question", "status", "required_for"],
  "properties": {
    "question_id": {"type": "string", "minLength": 1},
    "category": {"enum": ["change_reason", "business_funnel", "lead_quality", "geography", "incident", "pricing", "decision", "other"]},
    "question": {"type": "string", "minLength": 1},
    "entity_id": {"type": ["string", "null"]},
    "period": {"type": ["string", "null"]},
    "required_for": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "status": {"enum": ["OPEN", "ANSWERED", "CONFIRMED_UNKNOWN"]},
    "answer": {"type": ["string", "number", "boolean", "null"]},
    "respondent": {"type": ["string", "null"]},
    "answered_at": {"type": ["string", "null"], "format": "date-time"},
    "source_ref": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
